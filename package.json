{
  "name": "deploy.local",
  "version": "1.0.0",
  "bin": {
    "deploy": "./bin/deploy.js"
  },
  "type": "module",
  "scripts": {
    "server": "tsx server/index.ts",
    "client": "vite",
    "dev": "node scripts/run-pair.mjs dev",
    "dev:ui": "node scripts/dev-ui.mjs",
    "build": "node node_modules/react-flight-router/dist/bin/react-flight-router.js build && node scripts/build-server-extras.mjs",
    "start": "node dist/supervisor.js",
    "start:single": "node dist/server.js",
    "preview": "node scripts/run-pair.mjs preview",
    "lint": "oxlint . && node scripts/check-dl-styles.mjs && node scripts/check-design-literals.mjs && node scripts/check-motion-tokens.mjs && node scripts/check-native-token-parity.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node scripts/test.mjs",
    "typecheck": "tsrs --noEmit -p tsconfig.typecheck.json",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:visual:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:cli": "node scripts/build-cli.mjs",
    "build:design-local": "node scripts/build-design-local.mjs",
    "build:desktop-download": "node scripts/build-desktop-download.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs stop",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "service:status": "node scripts/service.mjs status",
    "menubar:build": "node scripts/menubar.mjs build",
    "menubar:install": "node scripts/menubar.mjs install",
    "menubar:uninstall": "node scripts/menubar.mjs uninstall",
    "prepare": "husky",
    "workspace:doctor": "node server/workspace/repository-doctor.ts",
    "workspace:repositories": "node server/workspace/repository-worker.ts",
    "workspace:worker": "node server/workspace/worker.ts",
    "workspace:remote": "node server/workspace/remote-worker.ts",
    "workspace:preview": "node server/workspace/preview.ts",
    "workspace:pipelines": "node server/workspace/pipeline-worker.ts",
    "workspace:recovery": "node server/workspace/recovery.ts",
    "icons:build": "node scripts/build-workspace-icons.mjs",
    "icons:check": "node scripts/build-workspace-icons.mjs --check",
    "lint:design": "node scripts/check-dl-styles.mjs && node scripts/check-design-literals.mjs && node scripts/check-motion-tokens.mjs && node scripts/check-native-token-parity.mjs"
  },
  "dependencies": {
    "@deploy.local/mdns": "workspace:*",
    "@dicebear/core": "10.7.0",
    "@hono/node-server": "catalog:",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "better-sqlite3": "^13.1.1",
    "busboy": "^1.6.0",
    "croner": "^11.0.0",
    "cronstrue": "^3.39.0",
    "drizzle-orm": "^0.45.4",
    "hono": "catalog:",
    "playwright": "catalog:",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-flight-router": "https://deploy.local/npm/react-flight-router/-/react-flight-router-0.16.0.tgz",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "catalog:",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.1",
    "ssh2": "1.17.0",
    "tar-stream": "^3.2.2",
    "typescript": "^7.0.2",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=26.1.0 <27"
  },
  "volta": {
    "node": "26.1.0"
  },
  "packageManager": "pnpm@11.1.3"
}
