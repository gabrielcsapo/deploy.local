{
  "name": "deploy.local",
  "version": "1.0.0",
  "bin": {
    "deploy": "./bin/deploy.js"
  },
  "type": "module",
  "scripts": {
    "server": "node scripts/flight-router.mjs && tsx server/index.ts",
    "client": "node scripts/flight-router.mjs && vite",
    "dev": "node scripts/flight-router.mjs && concurrently \"pnpm run server\" \"pnpm run client\" --names \"server,client\" --prefix-colors \"blue,magenta\"",
    "dev:ui": "node scripts/flight-router.mjs && node scripts/dev-ui.mjs",
    "build": "node scripts/flight-router.mjs && node packages/react-flight-router/dist/bin/react-flight-router.js build && node scripts/build-server-extras.mjs",
    "start": "node dist/supervisor.js",
    "start:single": "node dist/server.js",
    "preview": "node scripts/flight-router.mjs && concurrently \"pnpm run server\" \"vite preview\" --names \"server,preview\" --prefix-colors \"blue,magenta\"",
    "lint": "oxlint . && node scripts/check-design-literals.mjs && node scripts/check-motion-tokens.mjs && node scripts/check-native-token-parity.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node scripts/flight-router.mjs && node scripts/test.mjs",
    "typecheck": "node scripts/flight-router.mjs && tsc --noEmit",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:visual:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:cli": "node scripts/build-cli.mjs",
    "build:desktop-download": "node scripts/build-desktop-download.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs stop",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "service:status": "node scripts/service.mjs status",
    "menubar:build": "node scripts/menubar.mjs build",
    "menubar:install": "node scripts/menubar.mjs install",
    "menubar:uninstall": "node scripts/menubar.mjs uninstall",
    "release": "node scripts/release.mjs",
    "prepare": "husky",
    "workspace:doctor": "node server/workspace/repository-doctor.ts",
    "workspace:repositories": "node server/workspace/repository-worker.ts",
    "workspace:worker": "node server/workspace/worker.ts",
    "workspace:remote": "node server/workspace/remote-worker.ts",
    "workspace:preview": "node server/workspace/preview.ts",
    "workspace:pipelines": "node server/workspace/pipeline-worker.ts",
    "workspace:recovery": "node server/workspace/recovery.ts",
    "icons:build": "node scripts/build-workspace-icons.mjs",
    "icons:check": "node scripts/build-workspace-icons.mjs --check",
    "lint:design": "node scripts/check-design-literals.mjs && node scripts/check-motion-tokens.mjs && node scripts/check-native-token-parity.mjs"
  },
  "dependencies": {
    "@deploy.local/mdns": "workspace:*",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@hono/node-server": "catalog:",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.2",
    "busboy": "^1.6.0",
    "croner": "^10.0.1",
    "cronstrue": "^3.24.0",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "playwright": "catalog:",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-flight-router": "workspace:*",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "catalog:",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ssh2": "1.16.0",
    "tar-stream": "^3.2.0",
    "vite": "catalog:",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.6",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.1.0 <27"
  },
  "volta": {
    "node": "26.1.0"
  },
  "packageManager": "pnpm@11.1.3"
}
