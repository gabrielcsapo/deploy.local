{
  "name": "deploy.local",
  "version": "1.0.0",
  "bin": {
    "deploy": "./bin/deploy.js"
  },
  "type": "module",
  "scripts": {
    "server": "tsx server/index.ts",
    "client": "vite",
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\" --names \"server,client\" --prefix-colors \"blue,magenta\"",
    "dev:ui": "node scripts/dev-ui.mjs",
    "build": "react-flight-router build && node scripts/build-server-extras.mjs",
    "start": "node dist/supervisor.js",
    "start:single": "node dist/server.js",
    "preview": "concurrently \"pnpm run server\" \"vite preview\" --names \"server,preview\" --prefix-colors \"blue,magenta\"",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "dev:docs": "vite --config vite.docs.config.ts",
    "build:docs": "vite build --config vite.docs.config.ts",
    "preview:docs": "vite preview --config vite.docs.config.ts",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:visual:demo": "node scripts/visual-audit.mjs --demo",
    "audit:visual:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:cli": "node scripts/build-cli.mjs",
    "build:suitcase": "node docker/suitcase/build-images.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs stop",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "service:status": "node scripts/service.mjs status",
    "menubar:build": "node scripts/menubar.mjs build",
    "menubar:install": "node scripts/menubar.mjs install",
    "menubar:uninstall": "node scripts/menubar.mjs uninstall",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@deploy.local/mdns": "workspace:*",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hono/node-server": "^2.0.12",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.5",
    "better-sqlite3": "^13.0.2",
    "busboy": "^1.6.0",
    "croner": "^10.0.1",
    "cronstrue": "^3.24.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-flight-router": "0.12.0",
    "react-server-dom-webpack": "^19.2.8",
    "tar-stream": "^3.2.0",
    "vite": "^8.1.5",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "playwright": "^1.62.1",
    "postject": "1.0.0-alpha.6",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.1.0 <27"
  },
  "volta": {
    "node": "26.1.0"
  },
  "packageManager": "pnpm@11.1.3"
}
