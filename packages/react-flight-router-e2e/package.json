{
  "name": "react-flight-router-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/flight-router.mjs && vite",
    "build": "node ../../scripts/flight-router.mjs && node ../react-flight-router/dist/bin/react-flight-router.js build",
    "start": "node dist/server.js",
    "start:worker": "node ../../scripts/flight-router.mjs && node ./server.ts",
    "test:e2e": "node ../../scripts/flight-router.mjs && playwright test",
    "bench": "node ../../scripts/flight-router.mjs && bash scripts/benchmark.sh"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-flight-router": "workspace:*",
    "react-server-dom-webpack": "catalog:",
    "react-flight-router-shared-ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "artillery": "^2.0.32",
    "autocannon": "^8.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "catalog:"
  }
}
