{
  "name": "@deploy-local/node-app",
  "version": "0.1.0",
  "private": true,
  "description": "Linux background task worker, tray and desktop permission setup",
  "homepage": "https://github.com/gabrielcsapo/deploy.local",
  "license": "Apache-2.0",
  "author": {
    "name": "Gabriel J. Csapo",
    "email": "gabecsapo@gmail.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node scripts/start.mjs",
    "dist": "node build.mjs && electron-builder --linux --x64 --arm64",
    "test": "node --test src/*.test.ts"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.deploy.Node",
    "productName": "deploy.local Node",
    "executableName": "deploy-node",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist/node_modules/**/*",
      "package.json",
      "LICENSE"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "desktop": {
        "entry": {
          "NoDisplay": "true",
          "Comment": "Background task worker; run deploy-node --setup for setup"
        }
      }
    },
    "artifactName": "deploy-node-${version}-${arch}.${ext}"
  }
}
