{
  "name": "deploy-local-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "The deploy.local desktop shell and managed workspace worker",
  "license": "MIT",
  "author": "deploy.local contributors",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "test": "node --test test/*.test.mjs",
    "package:mac": "pnpm build && electron-builder --mac --dir",
    "package": "pnpm build && electron-builder",
    "package:check": "pnpm build && node scripts/package-check.mjs",
    "capture:electron": "pnpm build && node scripts/capture-electron.mjs",
    "package:mac:x64": "pnpm build && electron-builder --mac --x64 --dir"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "5.2.8",
    "electron": "44.9.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.1",
    "undici": "7.16.0"
  },
  "packageManager": "pnpm@11.1.3",
  "build": {
    "appId": "local.deploy.desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "build/shell-preload.cjs",
      "build/preload.cjs",
      "build/electron-trace.mjs",
      "build/build-info.json",
      "package.json",
      "build/app-worker.mjs"
    ],
    "extraResources": [
      {
        "from": "build/worker",
        "to": "worker"
      },
      {
        "from": "build/helpers",
        "to": "helpers"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "deploy.local contributors"
    },
    "icon": "assets/icon.png"
  },
  "productName": "deploy.local Desktop"
}
