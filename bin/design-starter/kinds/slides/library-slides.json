{
  "name": "Slides kind",
  "components": [
    {
      "id": "slide-title",
      "name": "Title slide",
      "group": "Slide layouts",
      "platform": "slide",
      "description": "The first slide: the display title bottom-left with one line under it.",
      "props": [
        {
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Project review"
        },
        {
          "id": "title",
          "label": "Title",
          "default": "__NAME__: where it stands"
        },
        {
          "id": "lede",
          "label": "Line",
          "default": "What we did, where the time went, and what comes next."
        },
        {
          "id": "notes",
          "label": "Speaker notes",
          "default": "What the speaker says here."
        }
      ],
      "html": "<section class=\"ds-slide title\"><div class=\"ds-slide-eyebrow\">{{eyebrow}}</div><h1 class=\"ds-slide-display\">{{title}}</h1><p class=\"ds-slide-lede\">{{lede}}</p><aside data-notes>{{notes}}</aside></section>"
    },
    {
      "id": "slide-statement",
      "name": "Statement slide",
      "group": "Slide layouts",
      "platform": "slide",
      "description": "One sentence, centred vertically, nothing else.",
      "props": [
        {
          "id": "text",
          "label": "Sentence",
          "default": "The first version is built and tested."
        },
        {
          "id": "notes",
          "label": "Speaker notes",
          "default": "What the speaker says here."
        },
        {
          "id": "deck",
          "label": "Deck name",
          "default": "__NAME__"
        },
        {
          "id": "n",
          "label": "Slide number",
          "default": "1"
        }
      ],
      "html": "<section class=\"ds-slide statement\"><h2 class=\"ds-slide-display\">{{text}}</h2><aside data-notes>{{notes}}</aside><div class=\"ds-slide-foot\"><span data-layer=\"deck-name\" data-deck-name>{{deck}}</span><span class=\"ds-slide-foot-num\" data-layer=\"slide-number\" data-slide-number>{{n}}</span></div></section>"
    },
    {
      "id": "slide-list",
      "name": "List slide",
      "group": "Slide layouts",
      "platform": "slide",
      "description": "A heading and three to five one-line items; each can be a build step.",
      "props": [
        {
          "id": "heading",
          "label": "Heading",
          "default": "Three things we did"
        },
        {
          "id": "notes",
          "label": "Speaker notes",
          "default": "What the speaker says here."
        },
        {
          "id": "deck",
          "label": "Deck name",
          "default": "__NAME__"
        },
        {
          "id": "n",
          "label": "Slide number",
          "default": "1"
        }
      ],
      "html": "<section class=\"ds-slide list\"><h2 class=\"ds-slide-heading\">{{heading}}</h2><ol class=\"ds-slide-list\" data-question=\"Are these the real steps?\"><li data-step=\"1\"><span class=\"n\">01</span>Set the goal and who it is for</li><li data-step=\"2\"><span class=\"n\">02</span>Built the first version</li><li data-step=\"3\"><span class=\"n\">03</span>Tried it with ten people</li></ol><aside data-notes>{{notes}}</aside><div class=\"ds-slide-foot\"><span data-layer=\"deck-name\" data-deck-name>{{deck}}</span><span class=\"ds-slide-foot-num\" data-layer=\"slide-number\" data-slide-number>{{n}}</span></div></section>"
    },
    {
      "id": "slide-picture",
      "name": "Picture slide",
      "group": "Slide layouts",
      "platform": "slide",
      "description": "Text at the left, a picture to the right edge.",
      "props": [
        {
          "id": "heading",
          "label": "Heading",
          "default": "The first version in June"
        },
        {
          "id": "lede",
          "label": "Line",
          "default": "Built in June, tried by ten people in July."
        },
        {
          "id": "notes",
          "label": "Speaker notes",
          "default": "What the speaker says here."
        },
        {
          "id": "deck",
          "label": "Deck name",
          "default": "__NAME__"
        },
        {
          "id": "n",
          "label": "Slide number",
          "default": "1"
        }
      ],
      "html": "<section class=\"ds-slide picture\"><div class=\"ds-slide-text\"><h2 class=\"ds-slide-heading\">{{heading}}</h2><p class=\"ds-slide-lede\">{{lede}}</p></div><div class=\"ds-slide-picture\"></div><aside data-notes>{{notes}}</aside><div class=\"ds-slide-foot\"><span data-layer=\"deck-name\" data-deck-name>{{deck}}</span><span class=\"ds-slide-foot-num\" data-layer=\"slide-number\" data-slide-number>{{n}}</span></div></section>"
    },
    {
      "id": "slide-two",
      "name": "Two columns slide",
      "group": "Slide layouts",
      "platform": "slide",
      "description": "Two short columns under a heading: before and after, this and that.",
      "props": [
        {
          "id": "heading",
          "label": "Heading",
          "default": "April and August"
        },
        {
          "id": "notes",
          "label": "Speaker notes",
          "default": "What the speaker says here."
        },
        {
          "id": "deck",
          "label": "Deck name",
          "default": "__NAME__"
        },
        {
          "id": "n",
          "label": "Slide number",
          "default": "1"
        }
      ],
      "html": "<section class=\"ds-slide two\"><h2 class=\"ds-slide-heading\">{{heading}}</h2><div class=\"ds-slide-cols\" data-question=\"Are these the real before and after?\"><div class=\"ds-slide-col\"><h3>April</h3><p>A goal and a plan, nothing built.</p></div><div class=\"ds-slide-col\"><h3>August</h3><p>A tested first version in use.</p></div></div><aside data-notes>{{notes}}</aside><div class=\"ds-slide-foot\"><span data-layer=\"deck-name\" data-deck-name>{{deck}}</span><span class=\"ds-slide-foot-num\" data-layer=\"slide-number\" data-slide-number>{{n}}</span></div></section>"
    },
    {
      "id": "slide-number",
      "name": "Big number slide",
      "group": "Slide layouts",
      "platform": "slide",
      "description": "One number at 160 px and what it means.",
      "props": [
        {
          "id": "number",
          "label": "Number",
          "default": "10"
        },
        {
          "id": "unit",
          "label": "Unit",
          "default": ""
        },
        {
          "id": "label",
          "label": "Meaning",
          "default": "People who tried the first version."
        },
        {
          "id": "notes",
          "label": "Speaker notes",
          "default": "What the speaker says here."
        },
        {
          "id": "deck",
          "label": "Deck name",
          "default": "__NAME__"
        },
        {
          "id": "n",
          "label": "Slide number",
          "default": "1"
        }
      ],
      "html": "<section class=\"ds-slide number\"><div class=\"ds-slide-bignumber\" data-question=\"Is this the real count?\">{{number}}<span class=\"unit\">{{unit}}</span></div><p class=\"ds-slide-numlabel\">{{label}}</p><aside data-notes>{{notes}}</aside><div class=\"ds-slide-foot\"><span data-layer=\"deck-name\" data-deck-name>{{deck}}</span><span class=\"ds-slide-foot-num\" data-layer=\"slide-number\" data-slide-number>{{n}}</span></div></section>"
    },
    {
      "id": "slide-bars",
      "name": "Bar chart",
      "group": "Slide blocks",
      "platform": "slide",
      "description": "Horizontal bars, for a few groups compared; --v is 0 to 100, the largest at 100; .focus puts the accent on the one that matters. Values the brief does not give are flagged.",
      "props": [],
      "html": "<div class=\"ds-slide-bars\" data-question=\"Are these the real hours per part?\"><div class=\"ds-slide-bar focus\"><span>Building</span><div class=\"ds-slide-bar-track\"><div class=\"ds-slide-bar-fill\" style=\"--v: 100\"></div></div><span class=\"ds-slide-bar-value\">104</span></div><div class=\"ds-slide-bar\"><span>Planning</span><div class=\"ds-slide-bar-track\"><div class=\"ds-slide-bar-fill\" style=\"--v: 38\"></div></div><span class=\"ds-slide-bar-value\">40</span></div><div class=\"ds-slide-bar\"><span>Testing</span><div class=\"ds-slide-bar-track\"><div class=\"ds-slide-bar-fill\" style=\"--v: 35\"></div></div><span class=\"ds-slide-bar-value\">36</span></div><div class=\"ds-slide-bar\"><span>Writing</span><div class=\"ds-slide-bar-track\"><div class=\"ds-slide-bar-fill\" style=\"--v: 19\"></div></div><span class=\"ds-slide-bar-value\">20</span></div></div>"
    },
    {
      "id": "slide-columns",
      "name": "Column chart",
      "group": "Slide blocks",
      "platform": "slide",
      "description": "Vertical columns, for a value over time (months, quarters, years), three to eight of them; --v is 0 to 100, the largest at 100; .focus puts the accent on the one that matters. Values the brief does not give are flagged.",
      "props": [],
      "html": "<div class=\"ds-slide-columns\" data-question=\"Are these the real hours per month?\"><div class=\"ds-slide-column\"><span class=\"ds-slide-column-value\">20</span><div class=\"ds-slide-column-track\"><div class=\"ds-slide-column-fill\" style=\"--v: 33\"></div></div><span class=\"ds-slide-column-label\">Apr</span></div><div class=\"ds-slide-column\"><span class=\"ds-slide-column-value\">35</span><div class=\"ds-slide-column-track\"><div class=\"ds-slide-column-fill\" style=\"--v: 58\"></div></div><span class=\"ds-slide-column-label\">May</span></div><div class=\"ds-slide-column\"><span class=\"ds-slide-column-value\">50</span><div class=\"ds-slide-column-track\"><div class=\"ds-slide-column-fill\" style=\"--v: 83\"></div></div><span class=\"ds-slide-column-label\">Jun</span></div><div class=\"ds-slide-column focus\"><span class=\"ds-slide-column-value\">60</span><div class=\"ds-slide-column-track\"><div class=\"ds-slide-column-fill\" style=\"--v: 100\"></div></div><span class=\"ds-slide-column-label\">Jul</span></div><div class=\"ds-slide-column\"><span class=\"ds-slide-column-value\">35</span><div class=\"ds-slide-column-track\"><div class=\"ds-slide-column-fill\" style=\"--v: 58\"></div></div><span class=\"ds-slide-column-label\">Aug</span></div></div>"
    },
    {
      "id": "slide-table",
      "name": "Table",
      "group": "Slide blocks",
      "platform": "slide",
      "description": "Three to five rows, three columns at most. A total goes in <tfoot> as tr.total and is the sum of the rows above it.",
      "props": [],
      "html": "<table class=\"ds-slide-table\" data-question=\"Are these the real hours per part?\"><thead><tr><th>Part</th><th>Who</th><th class=\"num\">Hours</th></tr></thead><tbody><tr><td>Planning</td><td>Everyone</td><td class=\"num\">40</td></tr><tr><td>Building</td><td>Two people</td><td class=\"num\">104</td></tr><tr><td>Testing and writing</td><td>One person each</td><td class=\"num\">56</td></tr></tbody><tfoot><tr class=\"total\"><td>Total</td><td></td><td class=\"num\">200</td></tr></tfoot></table>"
    },
    {
      "id": "slide-footer",
      "name": "Footer",
      "group": "Slide blocks",
      "platform": "slide",
      "description": "Deck name at the left, slide number at the right; on every slide but the title and the closing. deploy design check --fix sets both from the canvas order and the deck name.",
      "props": [
        {
          "id": "deck",
          "label": "Deck name",
          "default": "__NAME__"
        },
        {
          "id": "n",
          "label": "Slide number",
          "default": "1"
        }
      ],
      "html": "<div class=\"ds-slide-foot\"><span data-layer=\"deck-name\" data-deck-name>{{deck}}</span><span class=\"ds-slide-foot-num\" data-layer=\"slide-number\" data-slide-number>{{n}}</span></div>"
    },
    {
      "id": "slide-figures",
      "name": "Figures slide",
      "group": "Slide layouts",
      "platform": "slide",
      "description": "Two to four figures side by side, each a number and what it counts: a year in numbers. Use .n2, .n3 or .n4 on the row for the count; each has a value, a short label and an optional .context line; the values are the brief's, or plausible and flagged with data-question.",
      "props": [
        {
          "id": "heading",
          "label": "Heading",
          "default": "The project in three numbers"
        },
        {
          "id": "notes",
          "label": "Speaker notes",
          "default": "What the speaker says here."
        },
        {
          "id": "deck",
          "label": "Deck name",
          "default": "__NAME__"
        },
        {
          "id": "n",
          "label": "Slide number",
          "default": "1"
        }
      ],
      "html": "<section class=\"ds-slide figures\"><h2 class=\"ds-slide-heading\">{{heading}}</h2><div class=\"ds-slide-figures n3\" data-question=\"Are these the real figures?\"><div class=\"ds-slide-figure\" data-layer=\"figure-1\"><div class=\"value\">10</div><div class=\"label\">People tried the first version</div><div class=\"context\">In July</div></div><div class=\"ds-slide-figure focus\" data-layer=\"figure-2\"><div class=\"value\">200<span class=\"unit\">hours</span></div><div class=\"label\">Spent so far</div><div class=\"context\">Across all four parts</div></div><div class=\"ds-slide-figure\" data-layer=\"figure-3\"><div class=\"value\">5<span class=\"unit\">months</span></div><div class=\"label\">From start to now</div><div class=\"context\">April to August</div></div></div><aside data-notes>{{notes}}</aside><div class=\"ds-slide-foot\"><span data-layer=\"deck-name\" data-deck-name>{{deck}}</span><span class=\"ds-slide-foot-num\" data-layer=\"slide-number\" data-slide-number>{{n}}</span></div></section>"
    },
    {
      "id": "slide-closing",
      "name": "Closing slide",
      "group": "Slide layouts",
      "platform": "slide",
      "description": "The last slide: a closing line bottom-left and a ruled row of two to four ways to carry on (where to find it, who to ask, what is next), so it is not one line on empty space. No footer.",
      "props": [
        {
          "id": "text",
          "label": "Closing line",
          "default": "Questions, then next steps"
        },
        {
          "id": "notes",
          "label": "Speaker notes",
          "default": "What the speaker says here."
        }
      ],
      "html": "<section class=\"ds-slide closing\"><h2 class=\"ds-slide-display\">{{text}}</h2><div class=\"ds-slide-next n3\" data-question=\"Where does the deck live, who answers questions, and when is the next review?\"><div><span class=\"label\">Find it</span><span class=\"value\">The shared folder, under __NAME__</span></div><div><span class=\"label\">Ask</span><span class=\"value\">The project lead</span></div><div><span class=\"label\">Next</span><span class=\"value\">Next review in two weeks</span></div></div><aside data-notes>{{notes}}</aside></section>"
    }
  ]
}
