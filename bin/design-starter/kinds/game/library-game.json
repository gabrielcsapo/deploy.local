{
  "name": "Game kind",
  "components": [
    {
      "id": "game-stage",
      "name": "Game screen",
      "group": "Game layout",
      "platform": "game",
      "description": "A full-screen frame with the iPhone status bar and home indicator; .landscape for 844 x 390 (no status bar). The HUD and stage start below the status bar.",
      "props": [],
      "html": "<div class=\"ds-game\"><div class=\"ds-game-status\" data-layer=\"status-bar\" aria-hidden=\"true\"><span class=\"time\">9:41</span><span class=\"glyphs\"><svg viewBox=\"0 0 18 12\"><rect x=\"0\" y=\"8\" width=\"3\" height=\"4\" rx=\"1\"/><rect x=\"5\" y=\"5\" width=\"3\" height=\"7\" rx=\"1\"/><rect x=\"10\" y=\"2\" width=\"3\" height=\"10\" rx=\"1\"/><rect x=\"15\" y=\"0\" width=\"3\" height=\"12\" rx=\"1\"/></svg><svg viewBox=\"0 0 28 13\"><rect x=\"0.5\" y=\"0.5\" width=\"24\" height=\"12\" rx=\"3.5\" fill=\"none\" stroke=\"currentColor\" opacity=\".5\"/><rect x=\"2\" y=\"2\" width=\"21\" height=\"9\" rx=\"2.5\"/><rect x=\"26\" y=\"4.5\" width=\"2\" height=\"4\" rx=\"1\" opacity=\".5\"/></svg></span></div><div class=\"ds-game-home\" aria-hidden=\"true\"></div></div>"
    },
    {
      "id": "game-hud",
      "name": "HUD bar",
      "group": "Game layout",
      "platform": "game",
      "description": "Pause at the left, the level or score in the middle, lives at the right.",
      "props": [
        {
          "id": "label",
          "label": "Middle",
          "default": "Level 1"
        }
      ],
      "html": "<div class=\"ds-game-hud\"><button type=\"button\" class=\"ds-game-btn small\" aria-label=\"Pause\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 6v12M15 6v12\"/></svg></button><span class=\"grow\">{{label}}</span><span class=\"ds-game-pips\"><i></i><i></i><i class=\"off\"></i></span></div>"
    },
    {
      "id": "game-stage-area",
      "name": "Stage",
      "group": "Game layout",
      "platform": "game",
      "description": "The playfield; put flat shapes in it.",
      "props": [],
      "html": "<div class=\"ds-game-stage\"></div>"
    },
    {
      "id": "game-button",
      "name": "Round button",
      "group": "Game controls",
      "platform": "game",
      "description": "A 56 px thumb button; .small for 44 px, .primary for the one main one.",
      "props": [
        {
          "id": "label",
          "label": "Label",
          "default": "Jump"
        }
      ],
      "html": "<button type=\"button\" class=\"ds-game-btn primary\" aria-label=\"{{label}}\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 14l6-6 6 6\"/></svg></button>"
    },
    {
      "id": "game-play",
      "name": "Wide button",
      "group": "Game controls",
      "platform": "game",
      "description": "Play, Next, Resume: the primary action; .secondary for the quieter one.",
      "props": [
        {
          "id": "label",
          "label": "Label",
          "default": "Play"
        }
      ],
      "html": "<button type=\"button\" class=\"ds-game-play\" style=\"border: 0\">{{label}}</button>"
    },
    {
      "id": "game-grid",
      "name": "Level grid",
      "group": "Game levels",
      "platform": "game",
      "description": "Four across; tiles are done, available or locked.",
      "props": [],
      "html": "<div class=\"ds-game-grid\"><div class=\"ds-game-tile done\">1<svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></div><div class=\"ds-game-tile available\">2</div><div class=\"ds-game-tile locked\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z\"/></svg></div><div class=\"ds-game-tile locked\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6z\"/></svg></div></div>"
    },
    {
      "id": "game-result",
      "name": "Result card",
      "group": "Game results",
      "platform": "game",
      "description": "Level complete: stars, the score and two stats.",
      "props": [
        {
          "id": "title",
          "label": "Title",
          "default": "Level complete"
        },
        {
          "id": "score",
          "label": "Score",
          "default": "1,240"
        }
      ],
      "html": "<div class=\"ds-game-result\"><h2 class=\"ds-game-title\">{{title}}</h2><div class=\"ds-game-stars\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z\"/></svg><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z\"/></svg><span class=\"off\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z\"/></svg></span></div><div class=\"ds-game-score\">{{score}}</div><div class=\"ds-game-stats\"><div><span class=\"ds-game-label\">Time</span><strong>0:48</strong></div><div><span class=\"ds-game-label\">Best</span><strong>1,310</strong></div></div></div>"
    },
    {
      "id": "game-pause",
      "name": "Pause sheet",
      "group": "Game results",
      "platform": "game",
      "description": "Resume, Restart, Quit over the dimmed game.",
      "props": [],
      "html": "<div class=\"ds-game-dim\"></div><div class=\"ds-game-sheet\"><span class=\"grab\"></span><h2 class=\"ds-game-title\">Paused</h2><button type=\"button\" class=\"ds-game-play\" style=\"border: 0\">Resume</button><button type=\"button\" class=\"ds-game-play secondary\">Restart</button><button type=\"button\" class=\"ds-game-play secondary\">Quit</button></div>"
    },
    {
      "id": "game-control",
      "name": "Labelled control",
      "group": "Game controls",
      "platform": "game",
      "description": "A thumb button with its caption under it, for controls whose icon is not universal.",
      "props": [
        {
          "id": "label",
          "label": "Label",
          "default": "Jump"
        }
      ],
      "html": "<div class=\"ds-game-control\"><button type=\"button\" class=\"ds-game-btn\" aria-label=\"{{label}}\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 14l6-6 6 6\"/></svg></button><span class=\"ds-game-label\">{{label}}</span></div>"
    },
    {
      "id": "game-progress",
      "name": "Progress with caption",
      "group": "Game layouts",
      "platform": "game",
      "description": "A bar and its caption 8 px under it, 24 px before the next block; --v is 0 to 100.",
      "props": [
        {
          "id": "caption",
          "label": "Caption",
          "default": "Levels done of all levels"
        }
      ],
      "html": "<div class=\"ds-game-progress\"><div class=\"track\"><i style=\"--v: 0\"></i></div><span class=\"ds-game-label\">{{caption}}</span></div>"
    },
    {
      "id": "game-hud-slot",
      "name": "HUD with an empty right",
      "group": "Game layout",
      "platform": "game",
      "description": "For a game with no lives or timer: pause at the left, the level in the middle, an empty .slot at the right so the middle stays centred.",
      "props": [
        {
          "id": "label",
          "label": "Middle",
          "default": "Room 14: the flooded cellar"
        }
      ],
      "html": "<div class=\"ds-game-hud\"><button type=\"button\" class=\"ds-game-btn small\" aria-label=\"Pause\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 6v12M15 6v12\"/></svg></button><span class=\"grow\">{{label}}</span><span class=\"slot\" aria-hidden=\"true\"></span></div>"
    },
    {
      "id": "game-puzzle-stage",
      "name": "Puzzle stage at night",
      "group": "Game layout",
      "platform": "game",
      "description": "A light puzzle on a stage that is dark in both schemes (.night with data-theme=\"dark\"): the grid, a wall, mirrors the player turns (.fixed for one that does not), the emitter, the beam's path and a lit target.",
      "props": [],
      "html": "<div class=\"ds-game-stage night\" data-theme=\"dark\"><svg viewBox=\"0 0 358 480\" width=\"100%\" height=\"100%\" role=\"img\" aria-label=\"Puzzle board\"><rect class=\"cell\" x=\"19\" y=\"16\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"83\" y=\"16\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"147\" y=\"16\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"211\" y=\"16\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"275\" y=\"16\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"19\" y=\"80\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"83\" y=\"80\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"147\" y=\"80\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"211\" y=\"80\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"275\" y=\"80\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"19\" y=\"144\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"83\" y=\"144\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"147\" y=\"144\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"211\" y=\"144\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"275\" y=\"144\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"19\" y=\"208\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"83\" y=\"208\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"147\" y=\"208\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"211\" y=\"208\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"275\" y=\"208\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"19\" y=\"272\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"83\" y=\"272\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"147\" y=\"272\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"211\" y=\"272\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"275\" y=\"272\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"19\" y=\"336\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"83\" y=\"336\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"147\" y=\"336\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"211\" y=\"336\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"275\" y=\"336\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"19\" y=\"400\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"83\" y=\"400\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"147\" y=\"400\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"211\" y=\"400\" width=\"64\" height=\"64\"/><rect class=\"cell\" x=\"275\" y=\"400\" width=\"64\" height=\"64\"/><rect class=\"wall\" x=\"147\" y=\"208\" width=\"64\" height=\"64\"/><polyline class=\"beam\" points=\"51,112 243,112 243,368 307,368\"/><rect class=\"emitter\" x=\"35\" y=\"100\" width=\"24\" height=\"24\" rx=\"6\"/><line class=\"mirror\" x1=\"225\" y1=\"94\" x2=\"261\" y2=\"130\"/><line class=\"mirror\" x1=\"225\" y1=\"350\" x2=\"261\" y2=\"386\"/><line class=\"mirror\" x1=\"65\" y1=\"322\" x2=\"101\" y2=\"286\"/><line class=\"mirror fixed\" x1=\"161\" y1=\"450\" x2=\"197\" y2=\"414\"/><circle class=\"target lit\" cx=\"307\" cy=\"368\" r=\"14\"/></svg></div>"
    }
  ]
}
