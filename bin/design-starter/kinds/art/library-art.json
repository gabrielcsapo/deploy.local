{
  "name": "Art kind",
  "components": [
    {
      "id": "art-sheet",
      "name": "Sheet",
      "group": "Art",
      "platform": "art",
      "description": "The board: a 1280 wide sheet with its heading and one line on the grid and the play size. Everything else goes inside it.",
      "props": [
        {
          "id": "title",
          "label": "Title",
          "default": "__NAME__ sprites"
        }
      ],
      "html": "<main class=\"art-sheet\"><header class=\"art-head\"><h1>__NAME__ sprites</h1><p>16 px art on a 16 px tile, drawn at 48 px in play.</p></header></main>"
    },
    {
      "id": "art-palette",
      "name": "Palette",
      "group": "Art",
      "platform": "art",
      "description": "One .art-swatch per palette colour (a c-* class), named. Every colour the art uses is here; add one to art.css first.",
      "props": [],
      "html": "<div class=\"art-palette\"><figure class=\"art-swatch\"><i class=\"c-ink\"></i><figcaption>Ink</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-shade\"></i><figcaption>Shade</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-mid\"></i><figcaption>Mid</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-light\"></i><figcaption>Light</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-white\"></i><figcaption>White</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-red\"></i><figcaption>Red</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-orange\"></i><figcaption>Orange</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-yellow\"></i><figcaption>Yellow</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-brown\"></i><figcaption>Brown</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-dirt\"></i><figcaption>Dirt</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-green\"></i><figcaption>Green</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-leaf\"></i><figcaption>Leaf</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-blue\"></i><figcaption>Blue</figcaption></figure><figure class=\"art-swatch\"><i class=\"c-sky\"></i><figcaption>Sky</figcaption></figure></div>"
    },
    {
      "id": "art-grounds",
      "name": "Grounds",
      "group": "Art",
      "platform": "art",
      "description": "The backgrounds sprites are played on, labelled; the check draws every sprite on each at play size. Show the dark ones too.",
      "props": [],
      "html": "<div class=\"art-grounds\"><figure class=\"art-swatch wide\"><i class=\"art-ground g-day\"></i><figcaption>Day</figcaption></figure><figure class=\"art-swatch wide\"><i class=\"art-ground g-dusk\"></i><figcaption>Dusk</figcaption></figure><figure class=\"art-swatch wide\"><i class=\"art-ground g-night\"></i><figcaption>Night</figcaption></figure></div>"
    },
    {
      "id": "art-set",
      "name": "Set with frames",
      "group": "Art",
      "platform": "art",
