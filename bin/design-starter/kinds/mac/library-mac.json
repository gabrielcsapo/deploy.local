{
  "name": "Mac kind",
  "components": [
    {
      "id": "mac-window",
      "name": "Window",
      "group": "Mac layout",
      "platform": "mac",
      "description": "A window with its title bar and toolbar. The board is the window; wrap it in .ds-mac-desk.",
      "props": [
        {
          "id": "title",
          "label": "Title",
          "default": "All notes"
        },
        {
          "id": "sub",
          "label": "Subtitle",
          "default": "11 notes"
        }
      ],
      "html": "<div class=\"ds-mac-desk\"><div class=\"ds-mac-window\"><header class=\"ds-mac-titlebar\"><div class=\"ds-mac-lights\" aria-hidden=\"true\"><i></i><i></i><i></i></div><div class=\"ds-mac-titles\"><span class=\"ds-mac-title\">{{title}}</span><span class=\"ds-mac-subtitle\">{{sub}}</span></div><div class=\"ds-mac-spacer\"></div></header><div class=\"ds-mac-body\"></div></div></div>"
    },
    {
      "id": "mac-sidebar",
      "name": "Sidebar",
      "group": "Mac layout",
      "platform": "mac",
      "description": "Sections and items. The selected item is grey while the sidebar is not the focused pane, and the accent when it is (.focused on the sidebar); icons are in the accent.",
      "props": [
        {
          "id": "section",
          "label": "Section",
          "default": "Library"
        }
      ],
      "html": "<nav class=\"ds-mac-sidebar\"><div class=\"ds-mac-section\">{{section}}</div><div class=\"ds-mac-sideitem on\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01\"/></svg>All notes<span class=\"count\">11</span></div><div class=\"ds-mac-sideitem\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Recipes</div></nav>"
    },
    {
      "id": "mac-list",
      "name": "List pane",
      "group": "Mac layout",
      "platform": "mac",
      "description": "The middle pane of a three-pane split; the selected item is in the accent while this is the focused pane, grey with .unfocused on the list.",
      "props": [
        {
          "id": "name",
          "label": "Selected item",
          "default": "Soup stock notes"
        }
      ],
      "html": "<section class=\"ds-mac-list\"><div class=\"ds-mac-item on\"><span class=\"name\">{{name}}</span><span class=\"sub\">Edited yesterday</span></div><div class=\"ds-mac-item\"><span class=\"name\">Sourdough starter log</span><span class=\"sub\">Edited Monday</span></div></section>"
    },
    {
      "id": "mac-detail",
      "name": "Detail pane",
      "group": "Mac layout",
      "platform": "mac",
      "description": "The selected item: a title, one line of facts, then content.",
      "props": [
        {
          "id": "title",
          "label": "Title",
          "default": "Soup stock notes"
        }
      ],
      "html": "<main class=\"ds-mac-detail\"><h1>{{title}}</h1><p class=\"ds-mac-secondary\">Created 3 March, edited yesterday</p></main>"
    },
    {
      "id": "mac-inspector",
      "name": "Inspector",
      "group": "Mac layout",
      "platform": "mac",
      "description": "Properties of the selection, 260 px, at the right.",
      "props": [
        {
          "id": "label",
          "label": "Label",
          "default": "Name"
        }
      ],
      "html": "<aside class=\"ds-mac-inspector\"><div class=\"ds-mac-prop\"><span class=\"label\">{{label}}</span><div class=\"ds-mac-field\" style=\"min-width: 0\">Soup stock notes</div></div></aside>"
    },
    {
      "id": "mac-table",
      "name": "Table",
      "group": "Mac controls",
      "platform": "mac",
      "description": "24 px rows, 11 px header, selection in the accent.",
      "props": [
        {
          "id": "row",
          "label": "Selected row",
          "default": "onion-ratios.png"
        }
      ],
      "html": "<table class=\"ds-mac-table\"><thead><tr><th>Name</th><th class=\"num\">Size</th></tr></thead><tbody><tr><td>stock-timings.pdf</td><td class=\"num\">184 KB</td></tr><tr class=\"on\"><td>{{row}}</td><td class=\"num\">1.2 MB</td></tr></tbody></table>"
    },
    {
      "id": "mac-popup",
      "name": "Popup button",
      "group": "Mac controls",
      "platform": "mac",
      "description": "A choice of several values.",
      "props": [
        {
          "id": "value",
          "label": "Value",
          "default": "All items"
        }
      ],
      "html": "<div class=\"ds-mac-popup\"><span>{{value}}</span><span class=\"arrows\"><svg viewBox=\"0 0 12 12\"><path d=\"M3.5 4.5 6 2l2.5 2.5M3.5 7.5 6 10l2.5-2.5\"/></svg></span></div>"
    },
    {
      "id": "mac-check",
      "name": "Checkbox",
      "group": "Mac controls",
      "platform": "mac",
      "description": "On or off; .on for checked.",
      "props": [
        {
          "id": "label",
          "label": "Label",
          "default": "Show in the menu bar"
        }
      ],
      "html": "<div class=\"ds-mac-check on\"><span class=\"box\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2 5 8.7l4.5-5\"/></svg></span>{{label}}</div>"
    },
    {
      "id": "mac-seg",
      "name": "Segmented control",
      "group": "Mac controls",
      "platform": "mac",
      "description": "Two to four choices.",
      "props": [
        {
          "id": "one",
          "label": "Selected",
          "default": "List"
        }
      ],
      "html": "<div class=\"ds-mac-seg\"><span class=\"on\">{{one}}</span><span>Grid</span></div>"
    },
    {
      "id": "mac-search",
      "name": "Search field",
      "group": "Mac controls",
      "platform": "mac",
      "description": "In the toolbar at the right.",
      "props": [
        {
          "id": "hint",
          "label": "Placeholder",
          "default": "Search"
        }
      ],
      "html": "<div class=\"ds-mac-search\" style=\"width: 200px\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 11a6 6 0 1 0 12 0 6 6 0 0 0-12 0M16 16l4.5 4.5\"/></svg><span>{{hint}}</span></div>"
    },
    {
      "id": "mac-button",
      "name": "Push button",
      "group": "Mac controls",
      "platform": "mac",
      "description": "22 px tall; .default is the near-black one, one per window or sheet.",
      "props": [
        {
          "id": "label",
          "label": "Label",
          "default": "Done"
        }
      ],
      "html": "<button type=\"button\" class=\"ds-mac-btn default\">{{label}}</button>"
    },
    {
      "id": "mac-settings-tabs",
      "name": "Settings tabs",
      "group": "Mac settings",
      "platform": "mac",
      "description": "Toolbar tabs of a settings window: icon above label, current in the accent.",
      "props": [
        {
          "id": "tab",
          "label": "Current tab",
          "default": "General"
        }
      ],
      "html": "<nav class=\"ds-mac-tabs\"><div class=\"ds-mac-tab on\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h9M17 7h3M4 17h3M11 17h9\"/></svg>{{tab}}</div><div class=\"ds-mac-tab\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 6v6l4 2\"/></svg>Sync</div></nav>"
    },
    {
      "id": "mac-form",
      "name": "Settings form",
      "group": "Mac settings",
      "platform": "mac",
      "description": "Labels right-aligned in a 160 px column; popups 200 px wide so they line up; notes under a control; a column of checkboxes is .ds-mac-checks.",
      "props": [
        {
          "id": "label",
          "label": "Label",
          "default": "Startup"
        }
      ],
      "html": "<div class=\"ds-mac-form\"><span class=\"label\">{{label}}</span><div class=\"ds-mac-checks\"><div class=\"ds-mac-check on\"><span class=\"box\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2 5 8.7l4.5-5\"/></svg></span>Open the last note at launch</div><div class=\"ds-mac-check\"><span class=\"box\"></span>Show in the menu bar</div><span class=\"note\">The note you were reading opens where you left it.</span></div></div>"
    },
    {
      "id": "mac-menubar-extra",
      "name": "Menu-bar extra",
      "group": "Mac menu bar",
      "platform": "mac",
      "description": "The menu bar with one highlighted extra, and its popover.",
      "props": [
        {
          "id": "name",
          "label": "Name",
          "default": "__NAME__"
        }
      ],
      "html": "<div class=\"ds-mac-menubar\"><span class=\"app-name\">App</span><span class=\"grow\"></span><span class=\"extra on\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 7v5l3 2\"/></svg></span></div><div class=\"ds-mac-popover\"><div class=\"ds-mac-popover-head\"><span class=\"name\">{{name}}</span></div><div class=\"ds-mac-menu-row on\">Open window<span class=\"value\">Cmd O</span></div><hr class=\"ds-mac-rule\" /><div class=\"ds-mac-menu-row\">Quit<span class=\"value\">Cmd Q</span></div></div>"
    },
    {
      "id": "mac-sheet",
      "name": "Sheet",
      "group": "Mac dialogs",
      "platform": "mac",
      "description": "Drops from the title bar over a dimmed window; Cancel and one default button.",
      "props": [
        {
          "id": "title",
          "label": "Title",
          "default": "New collection"
        }
      ],
      "html": "<div class=\"ds-mac-dim\"></div><div class=\"ds-mac-sheet\"><h2>{{title}}</h2><p>Collections group notes from any folder; a note can be in more than one.</p><div class=\"ds-mac-sheet-foot\"><button type=\"button\" class=\"ds-mac-btn\">Cancel</button><button type=\"button\" class=\"ds-mac-btn default\">Create</button></div></div>"
    },
    {
      "id": "mac-settings-window",
      "name": "Settings window",
      "group": "Mac settings",
      "platform": "mac",
      "description": "The whole settings window: a plain title bar, toolbar tabs (icon above label, the current one in the accent), then a form. About 640 wide; no Save button, settings apply when changed.",
      "props": [
        {
          "id": "tab",
          "label": "Current tab",
          "default": "General"
        }
      ],
      "html": "<div class=\"ds-mac-window\"><header class=\"ds-mac-titlebar plain\"><div class=\"ds-mac-lights\" aria-hidden=\"true\"><i></i><i></i><i></i></div><span class=\"ds-mac-title\">{{tab}}</span></header><nav class=\"ds-mac-tabs\"><div class=\"ds-mac-tab on\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 3v3M12 18v3M3 12h3M18 12h3\"/></svg>{{tab}}</div><div class=\"ds-mac-tab\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h9M17 7h3M4 17h3M11 17h9\"/></svg>Sync</div><div class=\"ds-mac-tab\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>Updates</div></nav><div class=\"ds-mac-settings-body\"><div class=\"ds-mac-form\"><span class=\"label\">Startup</span><div class=\"ds-mac-checks\"><div class=\"ds-mac-check on\"><span class=\"box\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2 5 8.7l4.5-5\"/></svg></span>Open the last note at launch</div><div class=\"ds-mac-check\"><span class=\"box\"></span>Show in the menu bar</div></div><span class=\"label\">Start in</span><div><div class=\"ds-mac-popup\"><span>All notes</span><span class=\"arrows\"><svg viewBox=\"0 0 12 12\"><path d=\"M3.5 4.5 6 2l2.5 2.5M3.5 7.5 6 10l2.5-2.5\"/></svg></span></div></div><span class=\"label\">New notes</span><div class=\"ds-mac-textarea\">Start with the date, then a line for the title.</div></div></div></div>"
    },
    {
      "id": "mac-checks",
      "name": "Checkbox rows",
      "group": "Mac controls",
      "platform": "mac",
      "description": "A column of checkboxes under one form label, 8 px apart, with a note indented under the box it explains.",
      "props": [
        {
          "id": "label",
          "label": "First option",
          "default": "Open the last note at launch"
        }
      ],
      "html": "<div class=\"ds-mac-checks\"><div class=\"ds-mac-check on\"><span class=\"box\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2 5 8.7l4.5-5\"/></svg></span>{{label}}</div><span class=\"note\">The note you were reading opens where you left it.</span><div class=\"ds-mac-check\"><span class=\"box\"></span>Show in the menu bar</div></div>"
    },
    {
      "id": "mac-textarea",
      "name": "Text area",
      "group": "Mac controls",
      "platform": "mac",
      "description": "A multi-line field, 72 px tall; in a form it fills the control column, in a popover it is the grey fill without a border.",
      "props": [
        {
          "id": "text",
          "label": "Text",
          "default": "Stock keeps five days in the fridge, three months frozen."
        }
      ],
      "html": "<div class=\"ds-mac-textarea\">{{text}}<span class=\"caret\"></span></div>"
    },
    {
      "id": "mac-popover-placement",
      "name": "Popover under a tool",
      "group": "Mac dialogs",
      "platform": "mac",
      "description": "A popover opens under what opened it: .under-extra under a menu-bar extra, .under-tool under a toolbar item, right-aligned with a 16 px margin, in a .has-popover container.",
      "props": [
        {
          "id": "name",
          "label": "Title",
          "default": "Share note"
        }
      ],
      "html": "<div class=\"ds-mac-popover under-tool\"><div class=\"ds-mac-popover-head\"><span class=\"name\">{{name}}</span></div><div class=\"ds-mac-menu-row on\">Copy link</div><div class=\"ds-mac-menu-row\">Send a copy</div></div>"
    },
    {
      "id": "mac-note",
      "name": "Note text",
      "group": "Mac content",
      "platform": "mac",
      "description": "What the person wrote, in the detail pane: body text at 13 px with bold, a highlight, a heading, a list. Write it as their own note, never as filler.",
      "props": [
        {
          "id": "title",
          "label": "Title",
          "default": "Soup stock notes"
        }
      ],
      "html": "<main class=\"ds-mac-detail\"><h1>{{title}}</h1><p class=\"ds-mac-secondary\">Created 3 March, edited yesterday</p><div class=\"ds-mac-note\"><p>Roast the bones first: <strong>45 minutes at 220</strong>, turned once. Pale bones make a <mark>grey stock</mark>.</p><h2>For four litres</h2><ul><li>2 kg chicken wings and backs</li><li>2 onions, halved, skins on</li><li>1 leek, the green tops only</li></ul><p>Simmer, never boil, for four hours. Skim in the first half hour and leave it after.</p></div></main>"
    },
    {
      "id": "mac-checklist",
      "name": "Checklist",
      "group": "Mac content",
      "platform": "mac",
      "description": "A checklist inside a note: the round box, done items struck through in grey. Three to six items the person would really write.",
      "props": [
        {
          "id": "item",
          "label": "First item",
          "default": "Buy a 12 litre pot"
        }
      ],
      "html": "<ul class=\"ds-mac-checklist\"><li class=\"done\"><span class=\"box\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2 5 8.7l4.5-5\"/></svg></span><span>{{item}}</span></li><li class=\"done\"><span class=\"box\"><svg viewBox=\"0 0 12 12\"><path d=\"M2.5 6.2 5 8.7l4.5-5\"/></svg></span><span>Ask the butcher for backs on Friday</span></li><li><span class=\"box\"></span><span>Freeze in 500 ml tubs, labelled with the date</span></li></ul>"
    },
    {
      "id": "mac-format-bar",
      "name": "Format bar",
      "group": "Mac toolbar",
      "platform": "mac",
      "description": "The text tools in the title bar of a note window: style, then bold, italic and underline, then lists and the checklist. Icons and short glyphs, 28 px, the current style on.",
      "props": [],
      "html": "<div class=\"ds-mac-format\" role=\"toolbar\" aria-label=\"Format\"><button type=\"button\" class=\"ds-mac-tool\" aria-label=\"Paragraph style\">Aa</button><span class=\"sep\"></span><button type=\"button\" class=\"ds-mac-tool on\" aria-label=\"Bold\"><strong>B</strong></button><button type=\"button\" class=\"ds-mac-tool\" aria-label=\"Italic\"><em>I</em></button><button type=\"button\" class=\"ds-mac-tool\" aria-label=\"Underline\"><u>U</u></button><span class=\"sep\"></span><button type=\"button\" class=\"ds-mac-tool\" aria-label=\"Bulleted list\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01\"/></svg></button><button type=\"button\" class=\"ds-mac-tool\" aria-label=\"Checklist\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"7\" r=\"2.5\"/><circle cx=\"6\" cy=\"17\" r=\"2.5\"/><path d=\"M11 7h9M11 17h9\"/></svg></button></div>"
    },
    {
      "id": "mac-folder-picker",
      "name": "Folder picker",
      "group": "Mac controls",
      "platform": "mac",
      "description": "Moving a note: a popup with its menu open under it, the folders with their icons, the current one ticked and highlighted.",
      "props": [
        {
          "id": "folder",
          "label": "Current folder",
          "default": "Recipes"
        }
      ],
      "html": "<div><div class=\"ds-mac-popup\" style=\"width: 220px\"><span>{{folder}}</span><span class=\"arrows\"><svg viewBox=\"0 0 12 12\"><path d=\"M3.5 4.5 6 2l2.5 2.5M3.5 7.5 6 10l2.5-2.5\"/></svg></span></div><div class=\"ds-mac-menu\" role=\"menu\" style=\"margin-top: 4px\"><div class=\"ds-mac-menu-row\"><span class=\"tick\"></span><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>All notes</div><div class=\"ds-mac-menu-row on\"><span class=\"tick\">✓</span><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>{{folder}}</div><div class=\"ds-mac-menu-row\"><span class=\"tick\"></span><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Garden</div><div class=\"ds-mac-menu-row\"><span class=\"tick\"></span><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Trips</div><hr class=\"ds-mac-rule\" /><div class=\"ds-mac-menu-row\"><span class=\"tick\"></span>New folder…</div></div></div>"
    }
  ]
}
